{
  // Root-level TypeScript that lives outside any workspace package: Vitest
  // configs and the cross-cutting suites under tests/.
  "extends": "./tsconfig.base.json",
  "include": [
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.media.config.ts",
    "vitest.gcs.config.ts",
    "vitest.clamav.config.ts",
    "vitest.smtp.config.ts",
    "playwright.config.ts",
    "playwright.production.config.ts",
    "tests/**/*.ts"
  ]
}
