# Copy this file to .env.local (git-ignored) and fill in local values.
# NEVER commit real secrets. Generate strong values with e.g. `openssl rand -hex 32`.

NODE_ENV=development

# --- Interim Phase 0 authentication for the health-check console ---
# Replaced by the full identity/session system in Phase 1.
SESSION_SECRET=replace-with-a-32-byte-random-hex-string
HEALTHCHECK_API_TOKEN=replace-with-a-32-byte-random-hex-string
SESSION_TTL_SECONDS=3600

# --- Video generation provider ---
# Phase 0 uses the offline fake adapter and must NOT call the real API.
VIDEO_PROVIDER=fake

# --- WaveSpeedAI (server-side only; required only when VIDEO_PROVIDER=wavespeed) ---
WAVESPEED_API_KEY=
WAVESPEED_API_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_VIDEO_MODEL_ID=wavespeed-ai/open-video/image-to-video
WAVESPEED_WEBHOOK_SECRET=
WAVESPEED_POLL_INITIAL_MS=2000
WAVESPEED_POLL_MAX_MS=15000
WAVESPEED_POLL_TIMEOUT_MS=600000

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=false
