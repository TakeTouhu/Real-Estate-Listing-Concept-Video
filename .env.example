# Copy this file to .env.local (git-ignored) and fill in local values.
# NEVER commit real secrets. Generate strong values with e.g. `openssl rand -hex 32`.

NODE_ENV=development

# --- Database (Phase 1) ---
# PostgreSQL connection string used by Prisma. Required at runtime for
# database-backed features (auth, organizations). Not needed for build/tests.
# A production start of the web app refuses without it (ADR-0151).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revt?schema=public

# --- Operator token for the infrastructure readiness probe ---
# SESSION_SECRET keys the abuse limits' subjects (ADR-0170); changing it only
# starts every limit's count afresh.
SESSION_SECRET=replace-with-a-32-byte-random-hex-string
HEALTHCHECK_API_TOKEN=replace-with-a-32-byte-random-hex-string
SESSION_TTL_SECONDS=3600

# --- User session lifetime (Phase 1 authentication) ---
USER_SESSION_TTL_SECONDS=604800

# --- Object storage signing (Phase 2) ---
# HMAC secret for short-lived signed upload/download URLs. Server-side only.
STORAGE_SIGNING_SECRET=replace-with-a-32-byte-random-hex-string

# --- Shared storage folder (ADR-0085; development and CI only) ---
# An absolute folder in which the web app keeps stored objects, shared with the
# worker, so they survive a restart. Unset, they live in the web app's memory.
# Refused when NODE_ENV=production.
# SHARED_STORAGE_DIR=/absolute/path/to/.dev-storage

# --- Cloud Storage (ADR-0156 to ADR-0159) ---
# A bucket: 3 to 63 lowercase letters, digits, '.', '-' or '_', beginning and
# ending with a letter or a digit. In production, set it alone: the web app
# keeps its objects in Google's own store, as the service account it runs as.
# Elsewhere it needs the emulator's endpoint below, and it is refused beside
# SHARED_STORAGE_DIR. The development pipeline reads the same two settings in
# that folder's place (ADR-0162).
# GOOGLE_CLOUD_STORAGE_BUCKET=vtavision-dev
# The Cloud Storage emulator's origin, in development and CI only: refused in
# production, and refused at Google's own domain (docs/local-setup.md, 3b).
# GOOGLE_CLOUD_STORAGE_ENDPOINT=http://127.0.0.1:4443
# Node.js's own NODE_DEBUG writes requests, tokens included, to the error
# output: it is refused in production.
# NODE_TLS_REJECT_UNAUTHORIZED turns off Node.js's certificate check: it is
# refused in production.

# --- Malware scanning (ADR-0163, ADR-0164) ---
# The ClamAV daemon that scans each uploaded photo: a DNS name or an IP
# address, with no port. Unset, the web app uses the test scanner, which knows
# only the EICAR test file and is refused in production (docs/local-setup.md).
# CLAMAV_HOST=127.0.0.1
# Its TCP port, 3310 unless set. Refused without CLAMAV_HOST.
# CLAMAV_PORT=3310

# --- Email (ADR-0126, ADR-0129, ADR-0167, ADR-0168) ---
# A new account sees only the verify page until it opens the link mailed to
# it, so set both to sign up locally. With neither the folder nor SMTP_HOST,
# no email is sent and no new account can be verified.
# An absolute folder the web app writes every email to instead of sending it,
# one file each, readable by your user alone. Development and CI only: refused
# when NODE_ENV=production, and beside SMTP_HOST.
# EMAIL_OUTBOX_DIR=/absolute/path/to/.dev-outbox
# The web app's own address, which every emailed link starts with: an http(s)
# origin with no path, https in production. Never taken from a request.
# A production start of the web app refuses without it (ADR-0151).
# Set, it must be the exact origin the browser opens (scheme, host and port):
# every checked form and change from any other origin is refused (ADR-0174).
# APP_BASE_URL=http://localhost:3000
# The SMTP server production sends through: a DNS name, with no port and not
# an IP address, whose certificate Node.js trusts. Set, every one of the six
# below is required; unset, none may be. Development keeps the outbox above;
# never set both. The browser test refuses all seven.
# SMTP_HOST=smtp.example.com
# Its port: plain digits, 1 to 65535 (465 for implicit, 587 for starttls).
# SMTP_PORT=587
# implicit (TLS from the first byte) or starttls (required before login).
# SMTP_TLS=starttls
# The login. Kept in the secret manager in production; never logged.
# SMTP_USER=
# SMTP_PASSWORD=
# The DNS name this side gives in EHLO, so no container's name is sent.
# SMTP_EHLO_NAME=app.example.com
# The sender: one plain address in lower case, no display name, on the
# domain the mail service signs for.
# EMAIL_FROM=noreply@example.com

# --- MFA secret encryption (ADR-0065) ---
# 32-byte key (64 hex characters) sealing authenticator secrets at rest:
# `openssl rand -hex 32`. Server-side only; the web app needs it, the worker
# does not. Without it MFA is unavailable: a user with MFA on cannot finish
# signing in, and no one who must use MFA (every OWNER, ADMIN and BILLING) can
# sign in at all. Changing it makes existing MFA set-ups unusable.
# A production start of the web app refuses without it (ADR-0151).
# MFA_SECRET_KEY=

# --- Abuse limits (ADR-0170, ADR-0173) ---
# Each count/seconds: 1 to 99999 hits in 1 to 999999 seconds. Unset, the
# default below; no limit can be turned off.
# The browser test refuses them and runs the defaults. Raising a window
# forgets some counts early; lowering one deletes nothing early.
# Sign-in per typed address and per client address.
# RATE_LIMIT_SIGN_IN=5/900
# Wrong MFA codes per user.
# RATE_LIMIT_MFA_CODE=5/900
# Reset emails per address, and per client address.
# RATE_LIMIT_PASSWORD_RESET_EMAIL=3/3600
# RATE_LIMIT_PASSWORD_RESET_EMAIL_PER_IP=20/3600
# Verification emails per address.
# RATE_LIMIT_VERIFICATION_EMAIL=3/3600
# Sign-ups per client address, failed ones included; none is counted
# without a client address.
# RATE_LIMIT_SIGN_UP_PER_IP=60/3600
# Uploads per signed-in account: upload links, retries and checks
# together, failed ones included.
# RATE_LIMIT_UPLOAD=1000/86400
# Invitations per signed-in account, failed ones included.
# RATE_LIMIT_INVITATION=50/86400
# Analyses per signed-in account: analyses and refreshes together, failed
# ones included.
# RATE_LIMIT_ANALYSIS=300/3600
# Downloads per signed-in account: video downloads and photo download
# links together, failed ones included.
# RATE_LIMIT_DOWNLOAD=60/3600
# Video starts per signed-in account, failed and refused ones included.
# RATE_LIMIT_GENERATION_START=30/3600
# Unit purchase approvals per signed-in account, counted before the
# permission is checked, failed and refused ones included.
# RATE_LIMIT_UNIT_PURCHASE=10/3600
# How many entries at the right end of X-Forwarded-For your own
# infrastructure writes (1 to 5); the client is the left-most of them.
# Unset, nothing is limited by client address. A production start of the web
# app refuses without it; measure it on the deployment, never guess it.
# FORWARDED_FOR_TRUSTED_ENTRIES=2

# --- Video generation provider ---
# Phase 0 uses the offline fake adapter and must NOT call the real API.
VIDEO_PROVIDER=fake

# --- WaveSpeedAI (server-side only; required only when VIDEO_PROVIDER=wavespeed) ---
WAVESPEED_API_KEY=
WAVESPEED_API_BASE_URL=https://api.wavespeed.ai/api/v3
WAVESPEED_VIDEO_MODEL_ID=wavespeed-ai/open-video/image-to-video
WAVESPEED_WEBHOOK_SECRET=
WAVESPEED_POLL_INITIAL_MS=2000
WAVESPEED_POLL_MAX_MS=15000
WAVESPEED_POLL_TIMEOUT_MS=600000

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=false
