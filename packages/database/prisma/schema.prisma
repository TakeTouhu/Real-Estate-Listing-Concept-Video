// Phase 1 persistence schema. PostgreSQL is the system of record (DataModel.md).
// Public ids are application-generated (usr_/org_/...); provider ids and storage
// keys are introduced in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Role {
  OWNER
  ADMIN
  CREATOR
  REVIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PropertyStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum PropertyType {
  APARTMENT
  HOUSE
  OFFICE
  RETAIL
  OTHER
}

enum MediaAssetStatus {
  PENDING_UPLOAD
  UPLOADED
  SCANNING
  QUARANTINED
  PROCESSING
  READY
  REJECTED
  FAILED
  DELETION_PENDING
  DELETED
}

enum AnalysisStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ReviewStatus {
  UNREVIEWED
  APPROVED
  REJECTED
}

enum RoomType {
  LIVING_ROOM
  DINING_ROOM
  KITCHEN
  BEDROOM
  CHILD_ROOM
  STUDY
  BATHROOM
  WASHROOM
  TOILET
  ENTRANCE
  HALLWAY
  BALCONY
  STORAGE
  EXTERIOR
  OTHER
}

model Organization {
  id          String             @id
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships Membership[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model User {
  id          String       @id
  email       String       @unique
  name        String
  status      UserStatus   @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  credential  Credential?
  memberships Membership[]
  sessions    Session[]

  @@map("users")
}

model Credential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credentials")
}

model Membership {
  organizationId String
  userId         String
  role           Role
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id              String           @id
  organizationId  String
  email           String
  role            Role
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@map("invitations")
}

model Session {
  id        String   @id
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Property {
  id             String         @id
  organizationId String
  name           String
  propertyType   PropertyType
  addressMasked  String?
  description    String?
  status         PropertyStatus @default(ACTIVE)
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assets         MediaAsset[]
  videoProjects  VideoProject[]

  @@index([organizationId, status])
  @@map("properties")
}

model MediaAsset {
  id                  String            @id
  organizationId      String
  propertyId          String
  storageKey          String            @unique
  originalFilename    String
  mimeType            String?
  sizeBytes           Int?
  width               Int?
  height              Int?
  sha256              String?
  perceptualHash      String?
  status              MediaAssetStatus  @default(PENDING_UPLOAD)
  failureReason       String?
  thumbnailKey        String?
  createdBy           String
  deletionRequestedAt DateTime?
  retentionExpiresAt  DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  property            Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  analysis            AssetAnalysis?
  scenes              StoryboardScene[]

  // Referenced by storyboard_scenes so a scene and its project must belong to
  // the same property — and therefore the same organization — by construction.
  @@unique([id, propertyId])
  @@index([organizationId, propertyId, status])
  @@index([organizationId, sha256])
  @@map("media_assets")
}

model AssetAnalysis {
  id               String         @id
  organizationId   String
  assetId          String         @unique
  provider         String
  status           AnalysisStatus @default(PENDING)
  roomType         RoomType?
  confidence       Float?
  qualityScore     Float?
  brightnessScore  Float?
  blurScore        Float?
  duplicateGroup   String?
  detectedObjects  Json           @default("[]")
  safetyFlags      Json           @default("[]")
  suggestedOrder   Int?
  failureReason    String?
  /// Reviewer's corrected room classification. Null means the analyzer's
  /// `roomType` stands; the analyzer's value is never overwritten (ADR-0015).
  roomTypeOverride RoomType?
  /// Reviewer's global sort priority, lower first. **Not** an absolute final
  /// position, and deliberately not a fallback for `suggestedOrder` — how it
  /// participates in ordering belongs to the storyboard primitive (ADR-0015).
  /// Duplicate values across rows are allowed and resolve deterministically.
  orderOverride    Int?
  correctedBy      String?
  correctedAt      DateTime?
  analysisRevision Int            @default(1)
  reviewStatus     ReviewStatus   @default(UNREVIEWED)
  reviewNote       String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  asset            MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, duplicateGroup])
  @@index([organizationId, reviewStatus])
  // A partial unique index enforcing at most one APPROVED analysis per
  // duplicate group is added by raw SQL in the migration: Prisma cannot express
  // `WHERE` on an index. See docs/migration-notes.md.
  @@map("asset_analyses")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  resourceType   String
  resourceId     String
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum VideoProjectStatus {
  DRAFT
  STORYBOARD_READY
  STORYBOARD_STALE
}

/// Project-level settings for one property's walkthrough video.
///
/// Provider-neutral by design: aspect ratio, resolution and duration are stored
/// as requested, and validating them against an actual model's capabilities is
/// Phase 4 work, not a table of provisional limits here.
model VideoProject {
  id                     String             @id
  organizationId         String
  propertyId             String
  name                   String
  status                 VideoProjectStatus @default(DRAFT)
  durationSeconds        Int
  aspectRatio            String
  /// The product deliverable the customer asked for — a quality class, not a
  /// raster size and not a provider token (ADR-0034). Renamed in the Prisma
  /// model only: the physical column stays `resolution` via @map, so the
  /// migration renames nothing and no data moves. A CHECK constraint added by
  /// raw SQL restricts it to the closed product vocabulary.
  targetOutputResolution String             @map("resolution")
  stylePreset            String?
  cameraMotion           String?
  prompt                 String?
  negativePrompt         String?
  includeMusic           Boolean            @default(false)
  includeCaptions        Boolean            @default(false)
  brandTemplateId        String?
  /// Deterministic digest of the APPROVED analysis input set a storyboard was
  /// composed from — (assetId, analysisRevision, effectiveRoomType,
  /// orderOverride) over every eligible analysis, since Phase 3D-3 (ADR-0015).
  /// The last two carry the reviewer's corrections, which do not advance
  /// analysisRevision and would otherwise be invisible here. Freshness is
  /// derived by comparing it with the current eligible set, so no module has to
  /// notify this one when an analysis is refreshed or corrected.
  compositionFingerprint String?
  createdBy              String
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  property               Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  scenes                 StoryboardScene[]
  generations            SceneGeneration[]
  generationJobs         GenerationJob[]

  @@unique([id, propertyId])
  @@index([organizationId, propertyId])
  @@index([organizationId, status])
  @@map("video_projects")
}

/// One planned scene. Tenant scope is inherited through VideoProject rather
/// than denormalized: every read filters on the parent's organizationId, and
/// the composite foreign keys below make a cross-property — and so cross-tenant
/// — scene impossible to insert rather than merely discouraged.
model StoryboardScene {
  id                     String       @id
  videoProjectId         String
  propertyId             String
  assetId                String
  position               Int
  roomType               RoomType?
  durationSeconds        Int
  cameraMotion           String?
  compiledPrompt         String?
  /// Provenance: the analysis revision this scene was composed from.
  sourceAnalysisRevision Int
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  videoProject           VideoProject @relation(fields: [videoProjectId, propertyId], references: [id, propertyId], onDelete: Cascade)
  asset                  MediaAsset   @relation(fields: [assetId, propertyId], references: [id, propertyId], onDelete: Cascade)

  @@unique([videoProjectId, position])
  @@index([videoProjectId])
  @@map("storyboard_scenes")
}

enum SceneGenerationState {
  QUEUED
  SUBMITTING
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_TERMINAL
  SUBMISSION_UNKNOWN
  CANCELLED
}

/// One attempt to generate one scene through a video provider.
///
/// An attempt-and-history record, not a work item: it can represent a paid
/// external call, so it is written to outlive the things it refers to.
///
/// **Two of its id columns are deliberately NOT foreign keys.**
/// `sourceStoryboardSceneId` points at a row StoryboardService.compose routinely
/// deletes and recreates with a new id, and `assetId` points at a photo the
/// retention pipeline may remove. A cascade from either would erase the record
/// of a paid call on an ordinary user action, and a restrict would block
/// recomposition. Referential integrity is the wrong tool for a row the system
/// deliberately deletes; both are provenance (ADR-0016).
///
/// Tenant scope is inherited through VideoProject, never denormalized — the
/// same model storyboard_scenes uses.
model SceneGeneration {
  id                                String                                @id
  videoProjectId                    String
  /// Provenance only — no FK. Recomposition replaces storyboard scenes.
  sourceStoryboardSceneId           String
  /// Provenance only — no FK. Assets may be removed under retention policy.
  assetId                           String
  /// Which analysis revision the scene was composed from. Not request identity.
  sourceAnalysisRevision            Int
  /// Local idempotency identity: sha256 digest of the generation request facts.
  /// Unique per project across ACTIVE states only — enforced by the partial
  /// unique index added by raw SQL in the migration.
  requestHash                       String
  /// Internal only. Which provider and model the request was addressed to.
  providerName                      String
  providerModelId                   String
  /// --- Immutable request snapshot (ADR-0018) ---------------------------------
  /// Everything needed to rebuild the exact admitted provider request without
  /// dereferencing the storyboard scene (recomposition deletes it) or reading
  /// mutable project settings. With assetId + providerName + providerModelId
  /// above, these complete every requestHash fact, so a row can recompute
  /// its own hash. Nullable ONLY for rows admitted before this contract existed;
  /// those are never backfilled, because fabricating a snapshot from today's
  /// storyboard would forge a request that was never admitted.
  /// Customer-authored text. Never logged, audited, or put on a queue payload.
  requestCompiledPrompt             String?
  /// The scene's own allocated duration, not the project total.
  requestDurationSeconds            Int?
  /// Null is a legitimate request value here, not only a legacy marker.
  requestCameraMotion               String?
  requestAspectRatio                String?
  /// --- V1 identity, never written again (ADR-0034) ---------------------------
  /// The ambiguous single `resolution` used before the request identity was
  /// versioned. Retained, not dropped: the rows carrying it were hashed over it,
  /// so removing the column would destroy the only record of what a V1 attempt
  /// was admitted for, and rewriting it into the V2 columns would be a guess
  /// about which of its two meanings applied. A CHECK constraint requires it to
  /// be null on every V2 row, so no row can carry both vocabularies.
  requestResolution                 String?
  /// --- V2 delivery snapshot (ADR-0034) ---------------------------------------
  /// Which model was selected, what the customer was promised, what the provider
  /// is asked to generate, and how the two are reconciled. All-or-none, enforced
  /// by a CHECK constraint; all null means the attempt predates V2 and is
  /// deliberately NOT backfilled. requestNativeMeetsTarget is frozen rather than
  /// re-derived so a later catalog correction cannot restate what an approved
  /// attempt promised.
  requestModelKey                   String?
  requestTargetOutputResolution     String?
  requestNativeGenerationResolution String?
  requestResolutionNormalization    String?
  requestNativeMeetsTarget          Boolean?
  /// The exact provider prompt produced at admission, submitted verbatim.
  /// Frozen so a renderer change cannot alter an already-admitted attempt.
  /// Customer-authored text. Never logged, audited, or put on a queue payload.
  requestRenderedPrompt             String?
  state                             SceneGenerationState                  @default(QUEUED)
  /// --- Phase 4C-3B-2E orchestration linkage --------------------------------
  /// Every column below is NULLABLE, and that is a migration decision rather
  /// than a modelling one. Rows admitted before this phase have no logical
  /// request, no attempt ordinal and no recorded certainty, and there is no way
  /// to find out what they were: a legacy row in `SUBMITTING` might have been
  /// accepted or might never have been sent. Backfilling any of these would
  /// write a guess into the permanent record of a possibly-paid call.
  ///
  /// Newly admitted attempts populate them, and a CHECK constraint requires the
  /// whole orchestration set together — so a row is either fully legacy or
  /// fully orchestrated, never half of each.
  ///
  /// The parent logical request. NULL means "admitted before orchestration".
  generationSceneRequestId          String?
  /// Scoped to the parent request, starting at 1, never reused.
  attemptOrdinal                    Int?
  attemptKind                       GenerationAttemptKind?
  /// Whether the provider accepted this attempt. Separate from every execution
  /// state, and the reason `providerPredictionId` can be trusted: a database
  /// CHECK requires ACCEPTED whenever a prediction id is present.
  submissionCertainty               SubmissionCertainty?
  /// The pricing contract this attempt was admitted against, copied from its
  /// snapshot at admission and never supplied by a caller. It is what lets the
  /// provider boundary check that the cost decision belongs to *this* attempt
  /// rather than merely existing somewhere.
  pricingContractKey                String?
  /// The orchestration execution state. A separate column from `state` rather
  /// than a rewrite of it: legacy rows keep the legacy vocabulary, because
  /// relabelling a historical state is a claim nobody can verify now.
  orchestrationState                GenerationAttemptState?
  stateVersion                      Int                                   @default(0)
  /// When this attempt crossed into SUBMITTING. Set exactly once. A row with
  /// this set has been at the provider boundary and must never return to QUEUED.
  submissionBoundaryEnteredAt       DateTime?
  providerAcceptedAt                DateTime?
  reconciliationStartedAt           DateTime?
  /// Frozen when uncertainty begins, never recomputed from current config, so a
  /// later change to the reconciliation window cannot move an old deadline.
  reconciliationDeadlineAt          DateTime?
  reconciliationResolvedAt          DateTime?
  /// Internal only. Non-null exactly when a provider prediction is known.
  /// Never exposed to a customer (ADR-0016).
  providerPredictionId              String?
  submittedAt                       DateTime?
  lastPolledAt                      DateTime?
  /// Normalized execution diagnostics. Internal only; never a customer message.
  /// Not provider-only: a pre-provider preflight refusal is persisted as its
  /// exact reason code with a null message (ADR-0027).
  normalizedErrorCode               String?
  normalizedErrorMessage            String?
  /// --- Managed output integrity (Phase 4C-3B-2H-1, ADR-0038) ----------------
  /// Where the platform's own copy of the output lives, and what it is.
  ///
  /// All four are written together, exactly once, when an attempt reaches
  /// OUTPUT_VERIFIED, and are immutable afterwards: a later receipt describing
  /// different bytes is a discrepancy to surface rather than a correction to
  /// apply. A CHECK constraint requires all four on any row whose
  /// `orchestrationState` is OUTPUT_VERIFIED.
  ///
  /// Nullable because legacy rows have none of them and are never backfilled —
  /// there is no honest way to invent a digest for bytes nobody hashed. The
  /// constraint keys on `orchestrationState`, which is null on every legacy row,
  /// so historical data stays valid without exception logic.
  ///
  /// The storage key is *derived* from the organization and attempt id, so the
  /// same attempt always resolves to the same object and an interrupted copy can
  /// be retried over itself. A temporary provider URL is deliberately never
  /// persisted, here or anywhere.
  outputStorageKey                  String?
  /// Canonical lowercase 64-character hex, enforced by CHECK.
  outputSha256                      String?
  /// BigInt rather than Int: the domain admits any positive safe integer, and
  /// int4 would silently overflow at 2 GiB on a value the validator accepted.
  outputSizeBytes                   BigInt?
  /// One post-lock service clock instant. Never provider- or caller-supplied.
  outputVerifiedAt                  DateTime?
  createdAt                         DateTime                              @default(now())
  updatedAt                         DateTime                              @updatedAt
  /// RESTRICT, not Cascade. A generation may record a paid provider attempt, so
  /// a future physical project deletion must resolve retention policy
  /// deliberately rather than silently erasing history through a cascade that
  /// happened to be in the schema. No physical deletion path exists today, so
  /// this changes no current behaviour (docs/decisions/TODO.md).
  videoProject                      VideoProject                          @relation(fields: [videoProjectId], references: [id], onDelete: Restrict)
  /// RESTRICT again: the logical request must not be deletable while a provider
  /// attempt against it exists.
  generationSceneRequest            SceneGenerationRequest?               @relation(fields: [generationSceneRequestId], references: [id], onDelete: Restrict)
  pricingSnapshot                   GenerationPricingSnapshot?
  /// Optional, and absent is a meaningful state: an attempt that reached
  /// OUTPUT_VERIFIED before Phase 4C-3B-2H-3B-5 has no record, and the
  /// lifecycle runner discovers it rather than a backfill inventing one.
  mediaValidation                   ManagedOutputMediaValidation?
  /// The resolution work items that named this attempt as the recovery they
  /// produced. At most one in practice — the work is unique per validation and a
  /// request receives one automatic recovery — but the relation is a list
  /// because nothing in the schema makes that arithmetic true on its own.
  mediaFailureRecoveryFor           ManagedOutputMediaFailureResolution[] @relation("MediaFailureRecoveryAttempt")
  /// The deliverable plans that froze this attempt's output as a scene input.
  deliverableInputs                 GenerationDeliverableInput[]

  @@unique([generationSceneRequestId, attemptOrdinal])
  @@index([videoProjectId])
  @@index([state])
  @@index([generationSceneRequestId])
  /// Supports the media-validation candidate sweep, which orders by
  /// `outputVerifiedAt` within `orchestrationState = OUTPUT_VERIFIED`. No such
  /// index existed; the three above are on other columns entirely.
  @@index([orchestrationState, outputVerifiedAt])
  // At most one ACTIVE attempt per (videoProjectId, requestHash) is enforced by
  // a partial unique index added by raw SQL in the migration: Prisma cannot
  // express `WHERE` on an index. See docs/migration-notes.md.
  @@map("scene_generations")
}

// ===========================================================================
// Phase 4C-3B-2E — generation orchestration and audit state
//
// Six new tables and a certainty axis on the existing attempt row. The shape is
// driven by one accounting rule that the previous schema could not express:
//
//   a customer video unit is not a provider attempt
//
// One entitlement can produce an initial generation, up to two user
// regenerations, and any number of system recovery attempts. Collapsing those
// into one row makes every provider outage look like a customer charge, and
// makes "how many times did we pay for this?" unanswerable after the fact.
// ===========================================================================

enum GenerationQualityTier {
  NORMAL
  HIGH_QUALITY
}

enum GenerationJobState {
  CREATED
  RESERVING
  RESERVED
  GENERATING
  SCENES_READY
  COMPOSITION_PENDING
  COMPOSING
  DELIVERABLE_VALIDATING
  DELIVERABLE_READY
  REVISING
  FAILED_TERMINAL
  CANCELLED
}

enum GenerationReservationState {
  RESERVING
  RESERVED
  RECONCILIATION_HOLD
  CONSUMED
  RELEASED
}

enum GenerationSceneState {
  PENDING
  GENERATING
  READY
  REVISING
  FAILED_TERMINAL
  CANCELLED
}

enum SceneGenerationRequestKind {
  INITIAL
  USER_REGENERATION
}

enum SceneGenerationRequestState {
  PENDING
  GENERATING
  DELIVERED
  FAILED_TERMINAL
  CANCELLED
}

enum GenerationAttemptKind {
  PRIMARY
  SYSTEM_RECOVERY
}

/// Whether the provider accepted an attempt — an axis of its own, never
/// derivable from execution state. `SUBMISSION_UNKNOWN` is the case that proves
/// the separation: the attempt may be running and billable, or may never have
/// reached the provider, and one execution state covers both.
enum SubmissionCertainty {
  PRE_SUBMISSION
  ACCEPTED
  DEFINITIVELY_REJECTED
  SUBMISSION_UNKNOWN
}

/// The execution lifecycle of one provider attempt, in the orchestration
/// vocabulary. Deliberately a **separate enum** from the legacy
/// `SceneGenerationState`: legacy rows keep their own vocabulary and are never
/// relabelled, because renaming a historical state is a claim about what
/// happened that nobody can verify now.
enum GenerationAttemptState {
  QUEUED
  SUBMITTING
  PROCESSING
  RECONCILIATION_PENDING
  PROVIDER_SUCCEEDED
  OUTPUT_INGESTING
  OUTPUT_VERIFIED
  FAILED_RETRYABLE
  FAILED_TERMINAL
  RECONCILIATION_EXHAUSTED
  CANCELLED_PRE_SUBMISSION
}

enum GenerationTransitionAggregateType {
  JOB
  RESERVATION
  SCENE
  SCENE_REQUEST
  ATTEMPT
  DELIVERABLE
}

enum GenerationTransitionActorType {
  USER
  SYSTEM
  WORKER
  ADMIN
  RECONCILIATION_WORKER
}

/// One customer video lifecycle.
///
/// RESTRICT on the project, matching `SceneGeneration`: a job can hold a
/// consumed entitlement and a paid provider history, so a project deletion must
/// resolve retention deliberately rather than cascading it away.
model GenerationJob {
  id                          String                         @id
  videoProjectId              String
  requestedByUserId           String
  qualityTier                 GenerationQualityTier
  /// The product deliverable class, matching video_projects.resolution.
  /// The output configuration snapshotted from the VideoProject when this
  /// lifecycle began, and never read from the project again. Project settings
  /// are mutable; an attempt admitted three days later must be generated for
  /// what the customer started. A CHECK restricts the resolution to the closed
  /// product vocabulary, the same one video_projects carries.
  targetOutputResolution      String
  targetAspectRatio           String
  requestedDurationSeconds    Int
  /// Entitlement arithmetic, frozen at creation. High-quality units sit INSIDE
  /// the total; they are never additional.
  requiredVideoUnits          Int
  requiredHighQualityUnits    Int
  state                       GenerationJobState             @default(CREATED)
  stateVersion                Int                            @default(0)
  /// The deliverable version currently published to the customer, or null until
  /// one has been. Constrained by a composite foreign key to
  /// `(id, generationJobId)` on the version, so a non-null value can only ever
  /// name a version belonging to THIS job -- a nonexistent id and another job's
  /// id are both rejected by PostgreSQL. Exactly the pattern
  /// `GenerationScene.currentDeliveredRequestId` already uses.
  ///
  /// Composition *planning* never writes this. A planned version is discoverable
  /// by job plus highest ordinal; this pointer moves only when a validated
  /// deliverable is published, which is Transaction G's fact and is deferred.
  currentDeliverableVersionId String?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  videoProject                VideoProject                   @relation(fields: [videoProjectId], references: [id], onDelete: Restrict)
  reservation                 GenerationReservation?
  scenes                      GenerationScene[]
  deliverableVersions         GenerationDeliverableVersion[] @relation("JobDeliverableVersions")
  currentDeliverableVersion   GenerationDeliverableVersion?  @relation("JobCurrentDeliverable", fields: [currentDeliverableVersionId, id], references: [id, generationJobId], onDelete: Restrict)

  @@index([videoProjectId])
  @@index([state])
  @@map("generation_jobs")
}

/// One customer entitlement hold, one per job.
///
/// The billing cycle is frozen here and never recomputed. A job reserved on
/// 30 September and delivered on 1 October consumes September: the allowance
/// was committed when the platform began spending on the customer's behalf.
model GenerationReservation {
  id                       String                     @id
  generationJobId          String                     @unique
  billingCycleKey          String
  billingCycleStartedAt    DateTime
  billingCycleEndsAt       DateTime
  reservedTotalVideoUnits  Int
  reservedHighQualityUnits Int
  state                    GenerationReservationState @default(RESERVING)
  stateVersion             Int                        @default(0)
  reservedAt               DateTime                   @default(now())
  consumedAt               DateTime?
  releasedAt               DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  generationJob            GenerationJob              @relation(fields: [generationJobId], references: [id], onDelete: Restrict)

  @@index([billingCycleKey])
  @@map("generation_reservations")
}

/// One logical scene inside one job.
///
/// `sourceStoryboardSceneId` and `sourceAssetId` are provenance and carry NO
/// foreign key, for exactly the reason `SceneGeneration` gives: recomposition
/// deletes and recreates storyboard scenes, and retention removes assets. A
/// cascade from either would erase paid history on an ordinary user action, and
/// a restrict would block recomposition (ADR-0016).
model GenerationScene {
  id                        String                       @id
  generationJobId           String
  position                  Int
  /// Provenance only — no FK. Recomposition replaces storyboard scenes.
  sourceStoryboardSceneId   String
  /// Provenance only — no FK. Assets may be removed under retention policy.
  sourceAssetId             String
  sourceAnalysisRevision    Int
  snapshotDurationSeconds   Int
  snapshotCameraMotion      String?
  /// Customer-authored text. Never logged, audited, or placed in transition
  /// metadata — the same secrecy rule as SceneGeneration.requestCompiledPrompt.
  snapshotCompiledPrompt    String?
  state                     GenerationSceneState         @default(PENDING)
  stateVersion              Int                          @default(0)
  /// The delivered request currently selected for this scene. No FK: it points
  /// into a child table, and a circular required reference would make insertion
  /// order load-bearing.
  /// The delivered request currently selected for this scene. Constrained by a
  /// composite foreign key to `(id, generationSceneId)` on the request, so a
  /// non-null value can only ever name a request belonging to THIS scene --
  /// a nonexistent id and another scene's id are both rejected by PostgreSQL.
  currentDeliveredRequestId String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  generationJob             GenerationJob                @relation(fields: [generationJobId], references: [id], onDelete: Restrict)
  requests                  SceneGenerationRequest[]     @relation("SceneRequests")
  currentDeliveredRequest   SceneGenerationRequest?      @relation("SceneCurrentDelivered", fields: [currentDeliveredRequestId, id], references: [id, generationSceneId], onDelete: Restrict)
  deliverableInputs         GenerationDeliverableInput[]

  @@unique([generationJobId, position])
  @@index([generationJobId])
  @@map("generation_scenes")
}

/// One customer-visible request for a new rendition of a scene.
///
/// NOT a provider invocation. A provider failure creates another
/// `SceneGeneration` under this row; it does not create another of these, which
/// is what keeps a provider outage from consuming a customer's regeneration
/// right.
model SceneGenerationRequest {
  id                      String                       @id
  generationSceneId       String
  kind                    SceneGenerationRequestKind
  /// NULL for INITIAL, 1 or 2 for USER_REGENERATION. Both halves are enforced
  /// by a CHECK constraint, so a third regeneration cannot be inserted even by
  /// a caller that skipped the domain.
  userRegenerationOrdinal Int?
  state                   SceneGenerationRequestState  @default(PENDING)
  stateVersion            Int                          @default(0)
  requestedByUserId       String?
  createdAt               DateTime                     @default(now())
  deliveredAt             DateTime?
  failedAt                DateTime?
  generationScene         GenerationScene              @relation("SceneRequests", fields: [generationSceneId], references: [id], onDelete: Restrict)
  currentForScenes        GenerationScene[]            @relation("SceneCurrentDelivered")
  attempts                SceneGeneration[]
  deliverableInputs       GenerationDeliverableInput[]

  /// The composite key the scene's `currentDeliveredRequestId` points through,
  /// so a scene can only ever name a request that belongs to it.
  @@unique([id, generationSceneId])
  @@index([generationSceneId])
  @@map("scene_generation_requests")
}

/// The immutable provider-cost decision for exactly one attempt.
///
/// Monetary values are BIGINT, never floating point. The values come from the
/// domain's `PricingSnapshot` verbatim: nothing here recomputes a price, and no
/// update or delete path exists, because this row is the record of what the
/// platform believed a call would cost when it authorized the call.
model GenerationPricingSnapshot {
  id                            String          @id
  sceneGenerationId             String          @unique
  pricingVersion                String
  provider                      String
  contractKey                   String
  /// Encodes the contract's complete commercial content, not just its identity,
  /// so two contracts sharing an identity but differing in price or policy are
  /// distinguishable in the record.
  contractFingerprint           String
  identityJson                  Json
  stablePriceReferenceJson      Json
  riskProfileKey                String
  riskBufferBps                 Int
  requestedSeconds              Int
  billableSeconds               Int
  estimatedStableCostMicroUsd   BigInt
  estimatedPlanningCostMicroUsd BigInt
  pricingEffectiveAtEpochMs     BigInt
  fxSnapshotId                  String?
  createdAt                     DateTime        @default(now())
  sceneGeneration               SceneGeneration @relation(fields: [sceneGenerationId], references: [id], onDelete: Restrict)
  fxSnapshot                    FxRateSnapshot? @relation(fields: [fxSnapshotId], references: [id], onDelete: Restrict)

  @@index([contractKey])
  @@map("generation_pricing_snapshots")
}

/// An audited exchange rate, immutable once written.
///
/// A rational, never a decimal: a rate stored as a float cannot be re-checked
/// exactly, and a profitability figure that cannot say which rate produced it
/// cannot be re-derived at all. RESTRICT from pricing snapshots, so a rate that
/// priced a paid attempt cannot be deleted out from under it.
model FxRateSnapshot {
  id                 String                      @id
  baseCurrency       String
  quoteCurrency      String
  rateNumerator      BigInt
  rateDenominator    BigInt
  effectiveAtEpochMs BigInt
  sourceReference    String?
  createdAt          DateTime                    @default(now())
  pricingSnapshots   GenerationPricingSnapshot[]

  @@map("fx_rate_snapshots")
}

/// Append-only machine transition history.
///
/// Separate from `AuditLog` on purpose. `AuditLog` answers "what did a person
/// do?" and is read by support and compliance; this answers "what did the
/// machine do?" and is read during an incident. Pushing every polling
/// transition into the first would bury the customer-visible events that table
/// exists for.
///
/// There is no update or delete path anywhere in the repository layer.
model GenerationTransitionEvent {
  id             String                            @id
  /// Operational tenant scope, immutable, supplied by the scoped orchestration
  /// operation that appends the event -- never read out of `safeMetadata`.
  /// Carried here so history can be queried safely without reconstructing
  /// ownership from a polymorphic `aggregateId`. Deliberately NOT a foreign key
  /// with a cascade: paid history must not be deletable through an org row.
  organizationId String
  aggregateType  GenerationTransitionAggregateType
  aggregateId    String
  /// Per-aggregate, starting at 1. Unique with the aggregate, so a gap or a
  /// duplicate is a detectable defect rather than a silent reordering.
  sequence       Int
  fromState      String?
  toState        String
  eventType      String
  actorType      GenerationTransitionActorType
  actorUserId    String?
  reasonCode     String?
  /// Opaque. Groups every operation caused by one user request.
  correlationId  String
  causationId    String?
  /// Allowlisted keys only. Prompts, provider payloads, URLs and credentials
  /// are rejected before they reach this column.
  safeMetadata   Json                              @default("{}")
  createdAt      DateTime                          @default(now())

  @@unique([aggregateType, aggregateId, sequence])
  @@index([organizationId])
  @@index([aggregateId])
  @@index([correlationId])
  @@map("generation_transition_events")
}

// ===========================================================================
// Phase 4C-3B-2H-3B-5 — durable managed-output media-validation lifecycle
//
// One orthogonal durable fact, deliberately not another orchestration state.
//
// `OUTPUT_VERIFIED` remains terminal for the provider-attempt byte-integrity
// lifecycle and keeps its exact meaning: canonical managed bytes were copied
// and byte-level integrity was verified. Appending a media state after it would
// retroactively redefine what every already-`OUTPUT_VERIFIED` row claimed, and
// would bind a question about container structure to a state machine about
// provider execution. So media validity lives in its own one-to-one record with
// its own closed vocabulary, and nothing in this phase makes a Scene ready or
// creates a recovery attempt from it.
//
// Rows are NOT created by the completion transaction. An attempt that reached
// `OUTPUT_VERIFIED` before this phase has no validation record, and backfilling
// one would be inventing a verdict; the runner discovers absent records
// instead, which leaves completion untouched and makes history discoverable.
// ===========================================================================

enum ManagedOutputMediaValidationStatus {
  PENDING
  RUNNING
  VALID
  INVALID_MEDIA
  INTEGRITY_MISMATCH
}

enum ManagedOutputMediaInvalidReason {
  CONTAINER_UNSUPPORTED
  VIDEO_STREAM_MISSING
  VIDEO_DIMENSIONS_INVALID
  DURATION_INVALID
  PROBE_REJECTED
}

enum ManagedOutputContainerFamily {
  ISO_BMFF
}

model ManagedOutputMediaValidation {
  id                String                               @id
  /// One validation per attempt. The uniqueness is what makes two workers
  /// racing to create the first record resolvable: exactly one insert wins.
  sceneGenerationId String                               @unique
  status            ManagedOutputMediaValidationStatus   @default(PENDING)
  /// --- Immutable byte binding -----------------------------------------------
  /// Which bytes this verdict is about, frozen at creation. A validation answers
  /// a question about *specific* bytes; without naming them permanently, a
  /// record created against one object could later be read as a verdict about a
  /// different object at the same key — exactly what INTEGRITY_MISMATCH exists
  /// to detect. Never "repaired" to match a newer receipt.
  receiptSha256     String
  /// BIGINT for the same reason as `scene_generations.outputSizeBytes`: the
  /// domain admits any positive safe integer and int4 overflows at 2 GiB.
  receiptSizeBytes  BigInt
  /// --- Lease / retry --------------------------------------------------------
  /// Opaque and random. Carries no organization, scene, attempt, key or
  /// provider identity, so it discloses nothing if it is ever logged.
  leaseToken        String?
  /// Crash recovery, not a deadline: it says how long the system waits before
  /// assuming the owner died, not that the work must finish by then.
  leaseExpiresAt    DateTime?
  nextAttemptAt     DateTime?
  attemptCount      Int                                  @default(0)
  /// Incremented on every transition. With `leaseToken` this is what makes a
  /// stale worker's late finalize match zero rows.
  version           Int                                  @default(0)
  /// --- Terminal verdict -----------------------------------------------------
  invalidReason     ManagedOutputMediaInvalidReason?
  container         ManagedOutputContainerFamily?
  /// The five normalized media facts. BIGINT so a safe JS integer round-trips
  /// exactly; a CHECK bounds each at Number.MAX_SAFE_INTEGER so the column's
  /// range and the domain's range are the same range.
  durationMs        BigInt?
  videoWidth        BigInt?
  videoHeight       BigInt?
  videoStreamCount  BigInt?
  /// Zero is legal: a walkthrough with no audio track is valid media.
  audioStreamCount  BigInt?
  validatedAt       DateTime?
  createdAt         DateTime                             @default(now())
  updatedAt         DateTime                             @updatedAt
  /// RESTRICT, never Cascade. A validation record describes a possibly-paid
  /// attempt's output; a future physical deletion must resolve retention policy
  /// deliberately rather than erasing durable validation history through a
  /// cascade that happened to be in the schema.
  sceneGeneration   SceneGeneration                      @relation(fields: [sceneGenerationId], references: [id], onDelete: Restrict)
  /// Absent until a worker first claims this failure. Absent is the ordinary
  /// state for every VALID verdict and for every failure nobody has swept yet.
  failureResolution ManagedOutputMediaFailureResolution?
  /// The deliverable plans that cited this verdict as media authority.
  deliverableInputs GenerationDeliverableInput[]

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@map("managed_output_media_validations")
}

// ===========================================================================
// Phase 4C-3B-2H-3B-6C — durable media-failure resolution.
//
// A terminal media verdict now has durable *work* attached to it, rather than
// being re-derived by every sweep. The work is what makes two things possible
// that Phase 6B could not do: a planning refusal can be deferred to a future
// instant instead of re-offered immediately, and an exhausted automatic
// recovery can be settled exactly once.
//
// No backfill. Historical terminal failures are discovered lazily, exactly as
// the validation records themselves are: a row is created the first time a
// worker claims it, and an absent row is an eligible state rather than a gap.
// ===========================================================================

enum MediaFailureResolutionStatus {
  PENDING
  RUNNING
  RESOLVED
}

/// How one piece of resolution work ended.
///
/// `OBSOLETE` is narrow: it means a locked authority read proved no customer
/// mutation is required. It is never a catch-all for a shape nobody understood.
enum MediaFailureResolutionKind {
  RECOVERY_ADMITTED
  INITIAL_FAILURE_SETTLED
  USER_REGENERATION_ROLLED_BACK
  OBSOLETE
}

/// Why planning refused, as the closed application vocabulary and nothing else.
///
/// An enum rather than free text precisely because the alternative is a column
/// that eventually holds a provider error body or an FX vendor's URL.
enum MediaRecoveryPlanRefusalCode {
  PERSISTED_PRICING_IDENTITY_MALFORMED
  NO_SAFE_CURRENT_ROUTE
  NO_SAFE_CURRENT_PRICING
  AMBIGUOUS_CURRENT_PRICING
}

model ManagedOutputMediaFailureResolution {
  id                             String                        @id
  /// One piece of work per terminal verdict. The uniqueness is what makes two
  /// workers racing to create the first record resolvable: exactly one insert
  /// wins, and the loser reads what the winner wrote.
  managedOutputMediaValidationId String                        @unique
  status                         MediaFailureResolutionStatus  @default(PENDING)
  /// --- Lease / retry --------------------------------------------------------
  /// Opaque and random. Carries no organization, scene, attempt or key identity,
  /// so it discloses nothing if it is ever logged.
  leaseToken                     String?
  /// Crash recovery, not a deadline: how long the system waits before assuming
  /// the owner died.
  leaseExpiresAt                 DateTime?
  /// When a deferred row becomes a candidate again. Set on PENDING, and the
  /// reason an unplannable prefix cannot occupy every bounded sweep.
  nextAttemptAt                  DateTime?
  attemptCount                   Int                           @default(0)
  /// Incremented on every transition. With `leaseToken` this is what makes a
  /// stale worker's late finalize match zero rows.
  version                        Int                           @default(0)
  /// --- Deferral evidence ----------------------------------------------------
  lastPlanRefusalCode            MediaRecoveryPlanRefusalCode?
  /// --- Terminal record ------------------------------------------------------
  resolutionKind                 MediaFailureResolutionKind?
  /// The exact recovery attempt this work produced or reconciled to. RESTRICT,
  /// never Cascade: it names a possibly-paid attempt, so a physical deletion
  /// must resolve retention deliberately.
  recoveryAttemptId              String?
  resolvedAt                     DateTime?
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  /// RESTRICT for the same reason the validation itself uses it: this row is
  /// durable evidence about a possibly-paid attempt's failure.
  validation                     ManagedOutputMediaValidation  @relation(fields: [managedOutputMediaValidationId], references: [id], onDelete: Restrict)
  recoveryAttempt                SceneGeneration?              @relation("MediaFailureRecoveryAttempt", fields: [recoveryAttemptId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([recoveryAttemptId])
  @@map("managed_output_media_failure_resolutions")
}

// ===========================================================================
// Phase 5A — durable deliverable composition plan
//
// One question, made durable: *exactly which immutable scene renditions belong
// to the next customer deliverable?*
//
// Two tables rather than a column on the job. A deliverable is versioned — a
// successful user regeneration produces a second one — and each version must
// remember the exact ordered set of validated bytes it was planned from, or a
// crashed composition would re-derive that set from live rows that have since
// moved. The job then keeps a *pointer* to the version the customer currently
// holds, which planning never touches.
//
// No backfill. Nothing here reads, updates or rewrites an existing
// orchestration row: jobs that already delivered under earlier phases carry no
// deliverable version, and inventing one would be fabricating a plan that never
// existed.
// ===========================================================================

/// One planned customer deliverable, frozen.
///
/// `ordinal` is scoped to the job and derived as `MAX + 1` inside the admission
/// transaction, never accepted from a caller: an ordinal chosen outside that
/// transaction is a claim about rows the caller did not lock. It is deliberately
/// **not** the scene regeneration ordinal — one regeneration of one scene
/// produces one new deliverable version covering every scene.
///
/// RESTRICT on the job, matching every other row in this chain: a version can
/// name paid provider history, so a physical deletion must resolve retention
/// deliberately rather than cascading it away.
model GenerationDeliverableVersion {
  id               String                            @id
  generationJobId  String
  /// Job-scoped, starting at 1. A gap or a duplicate is a detectable defect.
  ordinal          Int
  /// `sha256:deliverable-input:v1:<hex>` over the canonical ordered input set
  /// plus the job's frozen delivery target. Not an object content hash, not the
  /// final video's SHA-256, not the storyboard composition fingerprint and not a
  /// provider request hash -- the prefix exists so a future reader cannot
  /// compare two of them by accident.
  inputFingerprint String
  createdAt        DateTime                          @default(now())
  generationJob    GenerationJob                     @relation("JobDeliverableVersions", fields: [generationJobId], references: [id], onDelete: Restrict)
  inputs           GenerationDeliverableInput[]
  /// The jobs whose current deliverable pointer names this version. At most one
  /// in practice -- the pointer is per job and the composite key confines it to
  /// this version's own job -- but the relation is a list because nothing in the
  /// schema makes that arithmetic true on its own.
  currentForJobs   GenerationJob[]                   @relation("JobCurrentDeliverable")
  /// The composition execution for this version, absent until a worker claims it.
  composition      GenerationDeliverableComposition?

  @@unique([generationJobId, ordinal])
  /// The composite key `GenerationJob.currentDeliverableVersionId` points
  /// through, so a job can only ever name a version that belongs to it.
  @@unique([id, generationJobId])
  @@index([generationJobId])
  @@map("generation_deliverable_versions")
}

/// One scene rendition frozen into one deliverable version.
///
/// The four foreign keys are the whole selection, recorded rather than
/// re-derivable: the scene, the request that was the scene's delivered pointer
/// at planning time, that request's latest `OUTPUT_VERIFIED` attempt, and the
/// `VALID` media verdict about that attempt's bytes. All RESTRICT -- this names
/// paid generated history end to end.
///
/// `sourceSha256` and `sourceSizeBytes` duplicate the attempt's verified
/// receipt on purpose, and it is the only duplication here. They are what make
/// the plan self-describing: a later reader can tell which bytes were planned
/// without joining four tables, and a receipt that ever disagreed with the
/// attempt's is then visible rather than assumed away. No other media metadata
/// is copied -- duration, dimensions and container stay where they were
/// measured.
model GenerationDeliverableInput {
  id                       String                       @id
  deliverableVersionId     String
  /// The `GenerationScene.position` frozen into the plan. Scenes are never
  /// renumbered by planning.
  position                 Int
  generationSceneId        String
  /// The scene's `currentDeliveredRequestId` at planning time -- the selection
  /// authority, never "the newest request" or "the highest regeneration
  /// ordinal".
  sceneGenerationRequestId String
  sceneGenerationAttemptId String
  mediaValidationId        String
  /// Canonical lowercase 64-character hex, enforced by CHECK.
  sourceSha256             String
  /// BIGINT for the same reason as `scene_generations.outputSizeBytes`: the
  /// domain admits any positive safe integer and int4 overflows at 2 GiB.
  sourceSizeBytes          BigInt
  createdAt                DateTime                     @default(now())
  deliverableVersion       GenerationDeliverableVersion @relation(fields: [deliverableVersionId], references: [id], onDelete: Restrict)
  generationScene          GenerationScene              @relation(fields: [generationSceneId], references: [id], onDelete: Restrict)
  sceneGenerationRequest   SceneGenerationRequest       @relation(fields: [sceneGenerationRequestId], references: [id], onDelete: Restrict)
  sceneGenerationAttempt   SceneGeneration              @relation(fields: [sceneGenerationAttemptId], references: [id], onDelete: Restrict)
  mediaValidation          ManagedOutputMediaValidation @relation(fields: [mediaValidationId], references: [id], onDelete: Restrict)

  /// A scene appears exactly once, at exactly one position, in one plan.
  @@unique([deliverableVersionId, position])
  @@unique([deliverableVersionId, generationSceneId])
  @@index([generationSceneId])
  @@index([sceneGenerationAttemptId])
  @@map("generation_deliverable_inputs")
}

// ===========================================================================
// Phase 5B — durable deliverable composition execution
//
// One row per deliverable version, recording what the platform has actually
// done about turning that frozen plan into one managed final object.
//
// The encoder profile is columns rather than a JSON blob, and that is the
// point: it is frozen when the row is created and every retry reuses the
// persisted values, so a later profile version cannot silently re-encode an
// existing deliverable differently. Columns make that constrainable by CHECK;
// a blob would make it a convention.
//
// No terminal failure status. A composition that cannot complete is operational
// work, not a verdict about the customer's job — see ADR-0050.
//
// No backfill. Deliverable versions planned by Phase 5A carry no composition
// row until a worker claims one.
// ===========================================================================

/// `BLOCKED` ends this phase's automatic work and nothing else: the job is not
/// terminalized, no unit is consumed, no reservation is released and the
/// deliverable pointer does not move. There is deliberately no `FAILED`.
enum DeliverableCompositionStatus {
  PENDING
  RUNNING
  BLOCKED
  OUTPUT_VERIFIED
}

/// Failures a later attempt could genuinely survive. A deterministic refusal
/// recorded here would be re-offered every retry interval forever.
enum DeliverableCompositionRetryCode {
  SOURCE_READ_RETRYABLE
  COMPOSER_RETRYABLE
  OUTPUT_PUBLISH_RETRYABLE
}

/// Refusals decidable against facts that cannot change by themselves: the plan
/// is immutable, the profile is frozen, and canonical objects are first-wins.
enum DeliverableCompositionBlockCode {
  SOURCE_BYTES_LIMIT_EXCEEDED
  DURATION_INVARIANT_MISMATCH
  SOURCE_INTEGRITY_MISMATCH
  OUTPUT_SIZE_LIMIT_EXCEEDED
}

model GenerationDeliverableComposition {
  id                   String                           @id
  /// One composition per planned deliverable version. The uniqueness is what
  /// makes two workers racing to create the first record resolvable: exactly
  /// one insert wins.
  deliverableVersionId String                           @unique
  status               DeliverableCompositionStatus     @default(PENDING)
  /// --- The frozen encoder profile ------------------------------------------
  /// Written once, at first claim, and never recomputed. A retry that re-derived
  /// today's defaults could encode the second half of a deliverable's history
  /// differently from the first.
  profileKey           String
  targetWidthPx        Int
  targetHeightPx       Int
  frameRateNumerator   Int
  frameRateDenominator Int
  videoCodec           String
  pixelFormat          String
  fitMode              String
  transitionMode       String
  audioMode            String
  encoderPreset        String
  crf                  Int
  /// --- Lease / retry -------------------------------------------------------
  /// Opaque and random. Carries no organization, job, deliverable, key or
  /// provider identity, so it discloses nothing if it is ever logged.
  leaseToken           String?
  /// Crash recovery, not a deadline: how long the system waits before assuming
  /// the owner died. Always longer than the composer timeout.
  leaseExpiresAt       DateTime?
  nextAttemptAt        DateTime?
  attemptCount         Int                              @default(0)
  /// Incremented on every transition. With `leaseToken` this is what makes a
  /// stale worker's late finalize match zero rows.
  version              Int                              @default(0)
  /// Closed vocabulary only. No ffmpeg stderr, storage message, OS error, path
  /// or customer text ever reaches this column.
  lastRetryCode        DeliverableCompositionRetryCode?
  /// --- The terminal block ---------------------------------------------------
  /// Written together when automatic execution stops for good, and never
  /// rewritten: a second, different reason would overwrite the one an operator
  /// is reading. There is no unblock operation in this phase.
  blockCode            DeliverableCompositionBlockCode?
  blockedAt            DateTime?
  /// --- The durable output receipt ------------------------------------------
  /// Written together, exactly once, when composition reaches OUTPUT_VERIFIED,
  /// and immutable afterwards: a later receipt describing different bytes is a
  /// discrepancy to surface rather than a correction to apply. The key is
  /// *derived* from the organization and deliverable version, so the same
  /// deliverable always resolves to the same object and an interrupted publish
  /// can be retried over itself.
  outputStorageKey     String?
  /// Canonical lowercase 64-character hex, enforced by CHECK.
  outputSha256         String?
  /// BigInt rather than Int: int4 would silently overflow on a value the
  /// publisher accepted.
  outputSizeBytes      BigInt?
  outputVerifiedAt     DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  /// RESTRICT, never Cascade. This row records paid generated history composed
  /// into a customer deliverable, so a physical deletion must resolve retention
  /// deliberately.
  deliverableVersion   GenerationDeliverableVersion     @relation(fields: [deliverableVersionId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@map("generation_deliverable_compositions")
}
